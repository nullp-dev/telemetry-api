{
  "id": null,
  "uid": "spring-boot-deepdive",
  "title": "Spring Boot - Deep Dive",
  "description": "Breakdown by endpoint (uri/method/status), Spring Data repositories, GC, threads and connection pool.",
  "tags": ["spring-boot", "deep-dive"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      { "name": "application", "type": "query", "datasource": { "type": "prometheus", "uid": "prometheus" }, "query": "label_values(jvm_threads_live_threads, application)", "refresh": 2, "includeAll": false, "multi": false, "current": { "text": "telemetry", "value": "telemetry" } },
      { "name": "uri", "type": "query", "datasource": { "type": "prometheus", "uid": "prometheus" }, "query": "label_values(http_server_requests_seconds_count{application=\"$application\"}, uri)", "refresh": 2, "includeAll": true, "multi": true, "current": { "text": "All", "value": "$__all" } }
    ]
  },
  "links": [
    { "title": "Overview", "url": "/d/spring-boot-overview", "type": "link", "icon": "dashboard" }
  ],
  "panels": [
    { "id": 1, "type": "row", "title": "HTTP by Endpoint", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 } },
    { "id": 10, "type": "timeseries", "title": "Request Rate by URI", "gridPos": { "x": 0, "y": 1, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{application=\"$application\",uri=~\"$uri\"}[$__rate_interval])) by (uri, method)", "legendFormat": "{{method}} {{uri}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] } },
    { "id": 11, "type": "timeseries", "title": "Latency P95 by URI", "gridPos": { "x": 12, "y": 1, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"$application\",uri=~\"$uri\"}[$__rate_interval])) by (le, uri))", "legendFormat": "{{uri}}" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] } },
    { "id": 12, "type": "timeseries", "title": "Latency P99 by URI", "gridPos": { "x": 0, "y": 9, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"$application\",uri=~\"$uri\"}[$__rate_interval])) by (le, uri))", "legendFormat": "{{uri}}" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] } },
    { "id": 13, "type": "timeseries", "title": "Errors by URI/Status", "gridPos": { "x": 12, "y": 9, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{application=\"$application\",uri=~\"$uri\",status=~\"4..|5..\"}[$__rate_interval])) by (uri, status) or vector(0)", "legendFormat": "{{uri}} [{{status}}]" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] } },

    { "id": 20, "type": "row", "title": "Spring Data Repository", "gridPos": { "x": 0, "y": 17, "w": 24, "h": 1 } },
    { "id": 21, "type": "timeseries", "title": "Invocations Rate by method", "gridPos": { "x": 0, "y": 18, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(spring_data_repository_invocations_seconds_count{application=\"$application\"}[$__rate_interval])) by (repository, method)", "legendFormat": "{{repository}}.{{method}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] } },
    { "id": 22, "type": "timeseries", "title": "Average Latency by method", "gridPos": { "x": 12, "y": 18, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(spring_data_repository_invocations_seconds_sum{application=\"$application\"}[$__rate_interval])) by (repository, method) / sum(rate(spring_data_repository_invocations_seconds_count{application=\"$application\"}[$__rate_interval])) by (repository, method)", "legendFormat": "{{repository}}.{{method}}" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] } },

    { "id": 30, "type": "row", "title": "JVM - Memory and GC", "gridPos": { "x": 0, "y": 26, "w": 24, "h": 1 } },
    { "id": 31, "type": "timeseries", "title": "Heap (by region)", "gridPos": { "x": 0, "y": 27, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "jvm_memory_used_bytes{application=\"$application\",area=\"heap\"}", "legendFormat": "{{id}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] } },
    { "id": 32, "type": "timeseries", "title": "Non-Heap (by region)", "gridPos": { "x": 8, "y": 27, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "jvm_memory_used_bytes{application=\"$application\",area=\"nonheap\"}", "legendFormat": "{{id}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] } },
    { "id": 33, "type": "timeseries", "title": "Classes Loaded", "gridPos": { "x": 16, "y": 27, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "jvm_classes_loaded_classes{application=\"$application\"}", "legendFormat": "loaded" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] } },
    { "id": 34, "type": "timeseries", "title": "GC Pauses (rate by cause)", "gridPos": { "x": 0, "y": 35, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(jvm_gc_pause_seconds_count{application=\"$application\"}[$__rate_interval])) by (cause, gc)", "legendFormat": "{{gc}} ({{cause}})" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] } },
    { "id": 35, "type": "timeseries", "title": "GC Pause - Average Duration", "gridPos": { "x": 8, "y": 35, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(jvm_gc_pause_seconds_sum{application=\"$application\"}[$__rate_interval])) by (cause) / sum(rate(jvm_gc_pause_seconds_count{application=\"$application\"}[$__rate_interval])) by (cause)", "legendFormat": "{{cause}}" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] } },
    { "id": 36, "type": "timeseries", "title": "GC Overhead (%)", "gridPos": { "x": 16, "y": 35, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "jvm_gc_overhead{application=\"$application\"} * 100", "legendFormat": "gc overhead" }],
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] } },

    { "id": 40, "type": "row", "title": "Threads, DB Pool and Infra", "gridPos": { "x": 0, "y": 43, "w": 24, "h": 1 } },
    { "id": 41, "type": "timeseries", "title": "Thread States (stacked)", "gridPos": { "x": 0, "y": 44, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "jvm_threads_states_threads{application=\"$application\"}", "legendFormat": "{{state}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "stacking": { "mode": "normal" } } }, "overrides": [] } },
    { "id": 42, "type": "timeseries", "title": "Hikari - Acquire / Usage Time (avg)", "gridPos": { "x": 8, "y": 44, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(hikaricp_connections_acquire_seconds_sum{application=\"$application\"}[$__rate_interval]) / rate(hikaricp_connections_acquire_seconds_count{application=\"$application\"}[$__rate_interval])", "legendFormat": "acquire" },
        { "expr": "rate(hikaricp_connections_usage_seconds_sum{application=\"$application\"}[$__rate_interval]) / rate(hikaricp_connections_usage_seconds_count{application=\"$application\"}[$__rate_interval])", "legendFormat": "usage" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] } },
    { "id": 43, "type": "timeseries", "title": "Hikari - Timeouts", "gridPos": { "x": 16, "y": 44, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "rate(hikaricp_connections_timeout_total{application=\"$application\"}[$__rate_interval])", "legendFormat": "timeouts/s" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] } },
    { "id": 44, "type": "gauge", "title": "Disk Usage (%)", "gridPos": { "x": 0, "y": 52, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "100 * (1 - disk_free_bytes{application=\"$application\"} / disk_total_bytes{application=\"$application\"})" }],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0, "thresholds": { "steps": [ { "value": 0, "color": "green" }, { "value": 70, "color": "yellow" }, { "value": 90, "color": "red" } ] } }, "overrides": [] } },
    { "id": 45, "type": "stat", "title": "Tomcat Active Sessions", "gridPos": { "x": 6, "y": 52, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "tomcat_sessions_active_current_sessions{application=\"$application\"}" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] } },
    { "id": 46, "type": "timeseries", "title": "Log Events Rate (by level)", "gridPos": { "x": 12, "y": 52, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "rate(logback_events_total{application=\"$application\"}[$__rate_interval])", "legendFormat": "{{level}}" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] } }
  ]
}
