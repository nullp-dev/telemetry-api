{
  "id": null,
  "uid": "postgres-exporter-overview",
  "title": "PostgreSQL - Overview",
  "description": "Health and performance dashboard for postgres_exporter: connections, cache hit ratio, transactions, locks, table stats, background writer, WAL and top queries (pg_stat_statements).",
  "tags": ["postgresql", "postgres-exporter"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      { "name": "datname", "type": "query", "datasource": { "type": "prometheus", "uid": "prometheus" }, "query": "label_values(pg_stat_database_numbackends, datname)", "refresh": 2, "includeAll": true, "multi": true, "current": { "text": "All", "value": "$__all" } }
    ]
  },
  "panels": [
    { "id": 1, "type": "row", "title": "Overview", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 } },
    { "id": 2, "type": "stat", "title": "Postgres Up", "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "pg_up" }],
      "fieldConfig": { "defaults": { "unit": "short", "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ] }, "overrides": [] } },
    { "id": 3, "type": "stat", "title": "Last Scrape Error", "gridPos": { "x": 4, "y": 1, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "pg_exporter_last_scrape_error" }],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [ { "value": 0, "color": "green" }, { "value": 1, "color": "red" } ] } }, "overrides": [] } },
    { "id": 4, "type": "stat", "title": "Last Scrape Duration", "gridPos": { "x": 9, "y": 1, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "pg_exporter_last_scrape_duration_seconds" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] } },
    { "id": 5, "type": "stat", "title": "Active Connections (total)", "gridPos": { "x": 14, "y": 1, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(pg_stat_database_numbackends{datname=~\"$datname\"})" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] } },
    { "id": 6, "type": "stat", "title": "Max Connections", "gridPos": { "x": 19, "y": 1, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "pg_settings_max_connections" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] } },

    { "id": 10, "type": "row", "title": "Database Health", "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 } },
    { "id": 11, "type": "timeseries", "title": "Database Size", "gridPos": { "x": 0, "y": 6, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "pg_database_size_bytes{datname=~\"$datname\"}", "legendFormat": "{{datname}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] } },
    { "id": 12, "type": "timeseries", "title": "Active Connections by Database", "gridPos": { "x": 8, "y": 6, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "pg_stat_database_numbackends{datname=~\"$datname\"}", "legendFormat": "{{datname}}" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] } },
    { "id": 13, "type": "gauge", "title": "Cache Hit Ratio", "gridPos": { "x": 16, "y": 6, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "100 * sum(rate(pg_stat_database_blks_hit{datname=~\"$datname\"}[$__rate_interval])) / (sum(rate(pg_stat_database_blks_hit{datname=~\"$datname\"}[$__rate_interval])) + sum(rate(pg_stat_database_blks_read{datname=~\"$datname\"}[$__rate_interval])))" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "steps": [ { "value": 0, "color": "red" }, { "value": 90, "color": "yellow" }, { "value": 99, "color": "green" } ] } }, "overrides": [] } },
    { "id": 14, "type": "timeseries", "title": "Transactions (commit vs rollback)", "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(pg_stat_database_xact_commit{datname=~\"$datname\"}[$__rate_interval])) by (datname)", "legendFormat": "{{datname}} commit" },
        { "expr": "sum(rate(pg_stat_database_xact_rollback{datname=~\"$datname\"}[$__rate_interval])) by (datname)", "legendFormat": "{{datname}} rollback" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] } },
    { "id": 15, "type": "timeseries", "title": "Disk Blocks Read vs Hit", "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(pg_stat_database_blks_hit{datname=~\"$datname\"}[$__rate_interval])) by (datname)", "legendFormat": "{{datname}} hit" },
        { "expr": "sum(rate(pg_stat_database_blks_read{datname=~\"$datname\"}[$__rate_interval])) by (datname)", "legendFormat": "{{datname}} read (disk)" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] } },

    { "id": 20, "type": "row", "title": "Locks & Conflicts", "gridPos": { "x": 0, "y": 22, "w": 24, "h": 1 } },
    { "id": 21, "type": "timeseries", "title": "Locks by Mode", "gridPos": { "x": 0, "y": 23, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "pg_locks_count{datname=~\"$datname\"}", "legendFormat": "{{datname}} {{mode}}" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] } },
    { "id": 22, "type": "timeseries", "title": "Deadlocks (rate)", "gridPos": { "x": 12, "y": 23, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(pg_stat_database_deadlocks{datname=~\"$datname\"}[$__rate_interval])) by (datname)", "legendFormat": "{{datname}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] } },
    { "id": 23, "type": "timeseries", "title": "Recovery Conflicts (rate)", "gridPos": { "x": 18, "y": 23, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(pg_stat_database_conflicts{datname=~\"$datname\"}[$__rate_interval])) by (datname)", "legendFormat": "{{datname}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] } },

    { "id": 30, "type": "row", "title": "Table Activity", "gridPos": { "x": 0, "y": 31, "w": 24, "h": 1 } },
    { "id": 31, "type": "timeseries", "title": "Row Changes (insert/update/delete)", "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(pg_stat_user_tables_n_tup_ins{datname=~\"$datname\"}[$__rate_interval])) by (relname)", "legendFormat": "{{relname}} insert" },
        { "expr": "sum(rate(pg_stat_user_tables_n_tup_upd{datname=~\"$datname\"}[$__rate_interval])) by (relname)", "legendFormat": "{{relname}} update" },
        { "expr": "sum(rate(pg_stat_user_tables_n_tup_del{datname=~\"$datname\"}[$__rate_interval])) by (relname)", "legendFormat": "{{relname}} delete" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] } },
    { "id": 32, "type": "timeseries", "title": "Sequential vs Index Scans", "gridPos": { "x": 12, "y": 32, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(pg_stat_user_tables_seq_scan{datname=~\"$datname\"}[$__rate_interval])) by (relname)", "legendFormat": "{{relname}} seq scan" },
        { "expr": "sum(rate(pg_stat_user_tables_idx_scan{datname=~\"$datname\"}[$__rate_interval])) by (relname)", "legendFormat": "{{relname}} index scan" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] } },
    { "id": 33, "type": "timeseries", "title": "Dead Tuples", "gridPos": { "x": 0, "y": 40, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "pg_stat_user_tables_n_dead_tup{datname=~\"$datname\"}", "legendFormat": "{{relname}}" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] } },
    { "id": 34, "type": "timeseries", "title": "Table + Index Size", "gridPos": { "x": 12, "y": 40, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "pg_stat_user_tables_table_size_bytes{datname=~\"$datname\"}", "legendFormat": "{{relname}} table" },
        { "expr": "pg_stat_user_tables_index_size_bytes{datname=~\"$datname\"}", "legendFormat": "{{relname}} index" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] } },

    { "id": 40, "type": "row", "title": "Background Writer & WAL", "gridPos": { "x": 0, "y": 48, "w": 24, "h": 1 } },
    { "id": 41, "type": "timeseries", "title": "Background Writer Buffers (rate)", "gridPos": { "x": 0, "y": 49, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(pg_stat_bgwriter_buffers_alloc_total[$__rate_interval])", "legendFormat": "alloc" },
        { "expr": "rate(pg_stat_bgwriter_buffers_clean_total[$__rate_interval])", "legendFormat": "clean" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] } },
    { "id": 42, "type": "stat", "title": "WAL Size", "gridPos": { "x": 8, "y": 49, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "pg_wal_size_bytes" }],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] } },
    { "id": 43, "type": "stat", "title": "WAL Segments", "gridPos": { "x": 16, "y": 49, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "pg_wal_segments" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] } },

    { "id": 50, "type": "row", "title": "Replication", "gridPos": { "x": 0, "y": 57, "w": 24, "h": 1 } },
    { "id": 51, "type": "stat", "title": "Is Replica", "gridPos": { "x": 0, "y": 58, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "pg_replication_is_replica" }],
      "fieldConfig": { "defaults": { "unit": "short", "mappings": [ { "type": "value", "options": { "0": { "text": "PRIMARY", "color": "blue" }, "1": { "text": "REPLICA", "color": "purple" } } } ] }, "overrides": [] } },
    { "id": 52, "type": "timeseries", "title": "Replication Lag", "gridPos": { "x": 6, "y": 58, "w": 18, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "pg_replication_lag_seconds", "legendFormat": "lag" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] } },

    { "id": 60, "type": "row", "title": "Top Queries (pg_stat_statements)", "gridPos": { "x": 0, "y": 64, "w": 24, "h": 1 } },
    { "id": 61, "type": "table", "title": "Top 10 Queries by Total Exec Time", "gridPos": { "x": 0, "y": 65, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "topk(10, pg_stat_statements_total_exec_time)", "format": "table", "instant": true }],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] } },
    { "id": 62, "type": "table", "title": "Top 10 Queries by Calls", "gridPos": { "x": 12, "y": 65, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "topk(10, pg_stat_statements_calls)", "format": "table", "instant": true }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] } },
    { "id": 63, "type": "timeseries", "title": "Mean Execution Time by Query", "gridPos": { "x": 0, "y": 74, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "pg_stat_statements_mean_exec_time", "legendFormat": "{{queryid}}" }],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] } }
  ]
}
