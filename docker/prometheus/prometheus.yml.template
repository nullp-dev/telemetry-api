global:
  scrape_interval: 30s
  scrape_timeout: 10s

scrape_configs:
  - job_name: 'telemetry-api'
    metrics_path: /actuator/prometheus
    scheme: https
    static_configs:
      - targets: ['${API_TARGET}']

  - job_name: 'postgres-exporter'
    metrics_path: /metrics
    scheme: https
    static_configs:
      - targets: ['${EXPORTER_TARGET}']